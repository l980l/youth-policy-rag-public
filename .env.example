# 승인된 온통청년 청년정책 API 키. 따옴표 없이 입력하세요.
YOUTH_API_KEY=
YOUTH_API_URL=https://www.youthcenter.go.kr/go/ythip/getPlcy
# Google AI Studio에서 발급받은 Gemini API 키. Git에 올리지 마세요.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# 검색 임베딩은 로컬 CPU로 실행하므로 API 한도를 사용하지 않습니다.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 기존 교육용 GMS 설정을 명시적으로 사용하는 경우에만 필요합니다.
GMS_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
REQUEST_INTERVAL=0.5
DATA_DIR=data/local

# Vercel 무료 데모에서만 사용. Gemini 프로젝트가 결제 미연결 무료 등급인지 확인한 뒤 true로 변경.
# 기본값 false에서는 호스팅 AI 호출이 차단됩니다. 로컬 실행에는 영향이 없습니다.
FREE_TIER_CONFIRMED=false
